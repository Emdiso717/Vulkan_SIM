void tet_rest_stable_neohookean_3d_hesNorm(out float norm, in mat4x3 V,
                                           in mat3 F0inv, in float vol0,
                                           in vec2 lame) {
  mat3 hes00, hes01, hes02, hes03, hes11, hes12, hes13, hes22, hes23, hes33;
  tet_rest_stable_neohookean_3d_hes(hes00, hes01, hes02, hes03, hes11, hes12,
                                    hes13, hes22, hes23, hes33, V, F0inv, vol0,
                                    lame);

  norm = mat3squaredNorm(hes00) + mat3squaredNorm(hes11) +
         mat3squaredNorm(hes22) + mat3squaredNorm(hes33) +
         2 * (mat3squaredNorm(hes01) + mat3squaredNorm(hes02) +
              mat3squaredNorm(hes03) + mat3squaredNorm(hes12) +
              mat3squaredNorm(hes13) + mat3squaredNorm(hes23));

  norm = sqrt(norm);
}
void main() {
  uvec3 id = gl_GlobalInvocationID;
  uint index = id.x;

  int st = elemParallelSlots[int(pushConsts.parallelSetStartIndex)];
  int ed = elemParallelSlots[int(pushConsts.parallelSetStartIndex) + 1];
  if (int(index) + st >= ed) {
    return;
  }

  const int elemId = int(index) + st;

  const ElementInfo elem = elementInfo[elemId];
  const float invDt = float(1) / params.deltaT;
  const float invDt2 = invDt * invDt;

  vec4 localMassInv;
  localMassInv[0] = 1.0 / masses[elem.pid[0]];
  localMassInv[1] = 1.0 / masses[elem.pid[1]];
  localMassInv[2] = 1.0 / masses[elem.pid[2]];
  localMassInv[3] = 1.0 / masses[elem.pid[3]];

  mat4x3 localV;
  localV[0] = particleIn[elem.pid[0]].pos.xyz;
  localV[1] = particleIn[elem.pid[1]].pos.xyz;
  localV[2] = particleIn[elem.pid[2]].pos.xyz;
  localV[3] = particleIn[elem.pid[3]].pos.xyz;

  vec3 localF0, localF1, localF2, localF3;
  tet_rest_stable_neohookean_3d_jac(localF0, localF1, localF2, localF3, localV,
                                    elem.restShapeInv, elem.restVol,
                                    params.lame.xy);
  localF0 = -localF0;
  localF1 = -localF1;
  localF2 = -localF2;
  localF3 = -localF3;

  float localHesNorm;
  tet_rest_stable_neohookean_3d_hesNorm(localHesNorm, localV, elem.restShapeInv,
                                        elem.restVol, params.lame.xy);
  const float localLambda = _lambdaD[elemId];
  const float localFNorm = sqrt(dot(localF0, localF0) + dot(localF1, localF1) +
                                dot(localF2, localF2) + dot(localF3, localF3));

  const float EPS = float(1e-8);
  // normalize local Force
  localF0 /= (localFNorm + EPS);
  localF1 /= (localFNorm + EPS);
  localF2 /= (localFNorm + EPS);
  localF3 /= (localFNorm + EPS);

  const float fenMu = localHesNorm * (localMassInv[0] * dot(localF0, localF0) +
                                      localMassInv[1] * dot(localF1, localF1) +
                                      localMassInv[2] * dot(localF2, localF2) +
                                      localMassInv[3] * dot(localF3, localF3)) +
                      invDt2;

  const float localDeltaLambda = -(localFNorm + localLambda * invDt2) / fenMu;

  localF0 *= -localMassInv[0] * localDeltaLambda;
  localF1 *= -localMassInv[1] * localDeltaLambda;
  localF2 *= -localMassInv[2] * localDeltaLambda;
  localF3 *= -localMassInv[3] * localDeltaLambda;

  // update lambdas
  _lambdaD[elemId] += localDeltaLambda;

  particleIn[elem.pid[0]].pos.xyz +=
      float(1 - fixedPoints[elem.pid[0]]) * localF0;

  particleIn[elem.pid[1]].pos.xyz +=
      float(1 - fixedPoints[elem.pid[1]]) * localF1;

  particleIn[elem.pid[2]].pos.xyz +=
      float(1 - fixedPoints[elem.pid[2]]) * localF2;

  particleIn[elem.pid[3]].pos.xyz +=
      float(1 - fixedPoints[elem.pid[3]]) * localF3;
}
