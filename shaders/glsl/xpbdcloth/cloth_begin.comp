#version 450

struct Particle {
  vec4 pos;
  vec4 vel;
  vec4 uv;
  vec4 normal;
};

layout(std430, binding = 0) buffer ParticleIn { Particle particleIn[]; };

layout(std430, binding = 1) buffer ParticleOut { Particle particleOut[]; };

layout(local_size_x = 32) in;

layout(binding = 2) uniform UBO {
  float deltaT;
  float particleMass;
  float springStiffness;
  float damping;
  float restDistH;
  float restDistV;
  float restDistD;
  float sphereRadius;
  vec4 spherePos;
  vec4 gravity;
  ivec2 particleCount;
}
params;

struct ElementInfo {
  int elemId;
  ivec2 pid;
  float restLength;
};

layout(std430, binding = 3) buffer LambdaBuffer { float _lambda[]; };

layout(std430, binding = 4) buffer ElementInfoBuffer {
  ElementInfo elementInfo[];
};

layout(std430, binding = 5) buffer ElemParallelSlotsBuffer {
  int elemParallelSlots[];
};

// Kept for pipeline layout compatibility with the solve stage
layout(push_constant) uniform PushConsts { uint parallelSetStartIndex; }
pushConsts;

bool isc(uint pid) { return pid == 0 || pid == 4160; }

void main() {
  uvec3 id = gl_GlobalInvocationID;
  uint index = id.x;
  uint numParticles = params.particleCount.x * params.particleCount.y;

  if (index < particleIn.length()) {
    vec3 dx = particleIn[index].vel.xyz * (params.deltaT);
    dx += params.gravity.xyz * (params.deltaT) * (params.deltaT);
    particleIn[index].vel = particleIn[index].pos;
    particleIn[index].pos.xyz += float(1.0 - float(isc(index))) * dx;
  }

  if (index < _lambda.length()) {
    _lambda[index] = 0.0;
  }
}
