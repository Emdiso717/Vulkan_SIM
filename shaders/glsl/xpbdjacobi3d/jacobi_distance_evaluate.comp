#version 450

layout(local_size_x = 64) in;

struct Particle {
  vec4 pos;
  vec4 vel;
  vec4 uv;
  vec4 normal;
};
struct EdgeInfo {
  ivec4 pid;
  vec4 restData;
};
layout(std430, binding = 0) readonly buffer Particles { Particle particles[]; };
layout(std140, binding = 1) uniform Params {
  float deltaT;
  float relaxation;
  float lameLambda;
  float lameMu;
  vec4 gravity;
  float damping;
  uint particleCount;
  uint edgeCount;
  uint elementCount;
} params;
layout(std430, binding = 2) readonly buffer MassesInv { float massesInv[]; };
layout(std430, binding = 3) readonly buffer FixedPoints { int fixedPoints[]; };
layout(std430, binding = 5) readonly buffer Edges { EdgeInfo edges[]; };
layout(std430, binding = 6) buffer EdgeCorrections { vec4 corrections[]; };

void main() {
  uint edgeId = gl_GlobalInvocationID.x;
  if (edgeId >= params.edgeCount) {
    return;
  }
  uint correction = 2 * edgeId;
  corrections[correction] = vec4(0.0);
  corrections[correction + 1] = vec4(0.0);
  EdgeInfo edge = edges[edgeId];
  float restLength = edge.restData.x;
  const float eps = 1.0e-12;
  if (restLength <= eps || params.lameMu <= eps) {
    return;
  }
  vec3 displacement = particles[edge.pid.y].pos.xyz - particles[edge.pid.x].pos.xyz;
  float length = sqrt(dot(displacement, displacement) + eps);
  float constraint = length / (restLength + eps) - 1.0;
  vec3 gradient = displacement / (length * (restLength + eps));
  float w0 = fixedPoints[edge.pid.x] != 0 ? 0.0 : massesInv[edge.pid.x];
  float w1 = fixedPoints[edge.pid.y] != 0 ? 0.0 : massesInv[edge.pid.y];
  float compliance = 1.0 / (params.lameMu * restLength + eps);
  float denominator = compliance / (params.deltaT * params.deltaT) +
                      (w0 + w1) * dot(gradient, gradient) + eps;
  if (isnan(constraint) || isinf(constraint) || isnan(denominator) ||
      isinf(denominator) || denominator <= eps) {
    return;
  }
  float deltaLambda = -constraint / denominator;
  corrections[correction] = vec4(-w0 * deltaLambda * gradient, 0.0);
  corrections[correction + 1] = vec4(w1 * deltaLambda * gradient, 0.0);
}
